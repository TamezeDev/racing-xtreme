<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zeki.racingxtreme.controller.LocalSelectionController">
   <children>
      <BorderPane id="rootPane" layoutX="1.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <ImageView fx:id="topBackground" pickOnBounds="true" BorderPane.alignment="TOP_LEFT">
               <image>
                  <Image url="@../img/background/topside-image.png" />
               </image>
            </ImageView>
         </top>
         <left>
            <ImageView fx:id="leftBackground" pickOnBounds="true" BorderPane.alignment="CENTER">
               <image>
                  <Image url="@../img/background/leftside-image.png" />
               </image>
            </ImageView>
         </left>
         <right>
            <ImageView fx:id="rightBackground" pickOnBounds="true" BorderPane.alignment="CENTER">
               <image>
                  <Image url="@../img/background/rightside-image.png" />
               </image>
            </ImageView>
         </right>
         <center>
            <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="model-labelA" text="Numero de Jugadores:" />
                  <ComboBox fx:id="playersComboBox" promptText="1 JUGADOR" styleClass="model-ComboBoxA" />
                  <Label styleClass="model-labelA" text="Dificultad:" />
                  <ComboBox fx:id="difficultComboBox" styleClass="model-ComboBoxA" />
                  <Label styleClass="model-labelA" text="Nº de carreras:" />
                  <ComboBox fx:id="racesComboBox" styleClass="model-ComboBoxA" />
                  <Label styleClass="model-labelA" text="Modo de juego:" />
                  <ComboBox fx:id="gameModeComboBox" promptText="Clasico" styleClass="model-ComboBoxA" />
                  <HBox alignment="CENTER" spacing="80.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#goBackToStartScene" styleClass="model-ButtonA" text="Retroceder" />
                        <Button mnemonicParsing="false" onAction="#goToSelectTeam" styleClass="model-ButtonA" text="Continuar" />
                     </children>
                     <VBox.margin>
                        <Insets top="50.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
